# TypeSafe API key (server-side only; never ship to the browser)
TYPESAFE_API_KEY=
# TYPESAFE_DEFAULT_MODEL=jev-latest
# PORT=3000

# Google sign-in. Leave GOOGLE_CLIENT_ID empty for local dev without login
# (the server refuses to start that way when NODE_ENV=production).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Random string, at least 32 characters: openssl rand -base64 48
SESSION_SECRET=
# Public URL of the deployment, used for the OAuth redirect.
# Render sets RENDER_EXTERNAL_URL automatically, so this is optional there.
# PUBLIC_URL=https://headline-desk.example.com

# Who may sign in (comma-separated). Both empty = any verified Google account.
# ALLOWED_DOMAINS=gmail.com,example.com
# ALLOWED_EMAILS=someone@gmail.com

# Analyses per user per hour (protects the shared API key)
# RATE_LIMIT_PER_HOUR=30

# Set to 1 to run with the offline heuristic stand-in instead of Jev
# TYPESAFE_MOCK=1
