# Anthropic API key for the Chrome extension's headline suggestions (server-side only).
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# Headline suggestions per person per hour from the extension
# HEADLINES_PER_HOUR=60

# TypeSafe API key for the Headline Desk web app (optional; server-side only)
TYPESAFE_API_KEY=
# TYPESAFE_DEFAULT_MODEL=jev-latest
# PORT=3000

# Google sign-in. Leave GOOGLE_CLIENT_ID empty for local dev without login
# (the server refuses to start that way when NODE_ENV=production).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Random string, at least 32 characters: openssl rand -base64 48
SESSION_SECRET=
# Public URL of the deployment, used for the OAuth redirect.
# Render sets RENDER_EXTERNAL_URL automatically, so this is optional there.
# PUBLIC_URL=https://headline-desk.example.com

# Who may sign in (comma-separated). Both empty = any verified Google account.
ALLOWED_DOMAINS=jagrannewmedia.com
# ALLOWED_EMAILS=someone@gmail.com
# Require accounts to be managed by the company's Google Workspace (recommended)
REQUIRE_WORKSPACE=1
# Optional: only these Chrome extension IDs may sign in (comma-separated)
# EXTENSION_IDS=

# Analyses per user per hour (protects the shared API key)
# RATE_LIMIT_PER_HOUR=30

# Set to 1 to run with the offline heuristic stand-in instead of Jev
# TYPESAFE_MOCK=1
